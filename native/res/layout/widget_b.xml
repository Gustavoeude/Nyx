<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_bg_b" android:contentDescription="@null"/>
    <ImageView android:id="@+id/w_deco" android:layout_width="76dp" android:layout_height="76dp" android:layout_gravity="top|end" android:layout_marginTop="10dp" android:layout_marginEnd="10dp" android:scaleType="fitCenter" android:contentDescription="@null"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
        <ImageView android:id="@+id/w_cover" android:layout_width="108dp" android:layout_height="108dp" android:scaleType="fitCenter" android:contentDescription="@null"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:id="@+id/w_info" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textSize="16sp" android:textStyle="bold" android:textColor="#FFEEF0FF"/>
            <TextView android:id="@+id/w_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:textSize="12sp" android:textColor="#FFAEB4F5"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <FrameLayout android:id="@+id/w_fav" android:layout_width="34dp" android:layout_height="34dp" >
            <ImageView android:id="@+id/w_fav_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_btn_circle" android:contentDescription="@null"/>
            <ImageView android:id="@+id/w_fav_ic" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="8dp" android:src="@drawable/ic_w_heart_border" android:contentDescription="@null"/>
        </FrameLayout>
                <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
                <FrameLayout android:id="@+id/w_prev" android:layout_width="34dp" android:layout_height="42dp" >
            <ImageView android:id="@+id/w_prev_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_btn_left" android:contentDescription="@null"/>
            <ImageView android:id="@+id/w_prev_ic" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="8dp" android:src="@drawable/ic_w_prev" android:contentDescription="@null"/>
        </FrameLayout>
                <FrameLayout android:id="@+id/w_play" android:layout_width="52dp" android:layout_height="52dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp">
            <ImageView android:id="@+id/w_play_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_cookie" android:contentDescription="@null"/>
            <ImageView android:id="@+id/w_play_ic" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="14dp" android:src="@drawable/ic_w_pause" android:contentDescription="@null"/>
        </FrameLayout>
                <FrameLayout android:id="@+id/w_next" android:layout_width="34dp" android:layout_height="42dp" >
            <ImageView android:id="@+id/w_next_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_btn_right" android:contentDescription="@null"/>
            <ImageView android:id="@+id/w_next_ic" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="8dp" android:src="@drawable/ic_w_next" android:contentDescription="@null"/>
        </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
