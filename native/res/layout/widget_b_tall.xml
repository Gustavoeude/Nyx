<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_bg_b" android:contentDescription="@null"/>
    <ImageView android:id="@+id/w_deco" android:layout_width="96dp" android:layout_height="96dp" android:layout_gravity="top|end" android:layout_marginTop="12dp" android:layout_marginEnd="12dp" android:scaleType="fitCenter" android:contentDescription="@null"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_horizontal" android:orientation="vertical" android:padding="18dp">
        <ImageView android:id="@+id/w_cover" android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" android:layout_marginStart="26dp" android:layout_marginEnd="26dp" android:adjustViewBounds="false" android:scaleType="fitCenter" android:contentDescription="@null"/>
        <LinearLayout android:id="@+id/w_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical">
            <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textSize="20sp" android:textStyle="bold" android:textColor="#FFEEF0FF" android:gravity="center_horizontal"/>
            <TextView android:id="@+id/w_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:textSize="14sp" android:textColor="#FFAEB4F5" android:gravity="center_horizontal"/>
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
            <FrameLayout android:id="@+id/w_fav" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginEnd="10dp">
            <ImageView android:id="@+id/w_fav_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_btn_circle" android:contentDescription="@null"/>
            <ImageView android:id="@+id/w_fav_ic" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="9dp" android:src="@drawable/ic_w_heart_border" android:contentDescription="@null"/>
        </FrameLayout>
            <FrameLayout android:id="@+id/w_prev" android:layout_width="46dp" android:layout_height="52dp" >
            <ImageView android:id="@+id/w_prev_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_btn_left" android:contentDescription="@null"/>
            <ImageView android:id="@+id/w_prev_ic" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="10dp" android:src="@drawable/ic_w_prev" android:contentDescription="@null"/>
        </FrameLayout>
            <FrameLayout android:id="@+id/w_play" android:layout_width="66dp" android:layout_height="66dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp">
            <ImageView android:id="@+id/w_play_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_cookie" android:contentDescription="@null"/>
            <ImageView android:id="@+id/w_play_ic" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="17dp" android:src="@drawable/ic_w_pause" android:contentDescription="@null"/>
        </FrameLayout>
            <FrameLayout android:id="@+id/w_next" android:layout_width="46dp" android:layout_height="52dp" >
            <ImageView android:id="@+id/w_next_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_btn_right" android:contentDescription="@null"/>
            <ImageView android:id="@+id/w_next_ic" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="10dp" android:src="@drawable/ic_w_next" android:contentDescription="@null"/>
        </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
