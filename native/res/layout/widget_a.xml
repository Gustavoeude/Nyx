<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_bg_a" android:contentDescription="@null"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="9dp" android:paddingEnd="14dp" android:paddingTop="6dp" android:paddingBottom="6dp">
        <ImageView android:id="@+id/w_cover" android:layout_width="54dp" android:layout_height="54dp" android:scaleType="fitCenter" android:contentDescription="@null"/>
        <LinearLayout android:id="@+id/w_info" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textSize="14sp" android:textStyle="bold" android:textColor="#FFEEF0FF" />
            <TextView android:id="@+id/w_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:textSize="12sp" android:textColor="#FFAEB4F5" />
        </LinearLayout>
        <FrameLayout android:id="@+id/w_prev" android:layout_width="36dp" android:layout_height="36dp" >
            <ImageView android:id="@+id/w_prev_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_btn_circle" android:contentDescription="@null"/>
            <ImageView android:id="@+id/w_prev_ic" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="9dp" android:src="@drawable/ic_w_prev" android:contentDescription="@null"/>
        </FrameLayout>
        <FrameLayout android:id="@+id/w_play" android:layout_width="52dp" android:layout_height="52dp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp">
            <ImageView android:id="@+id/w_play_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_cookie" android:contentDescription="@null"/>
            <ImageView android:id="@+id/w_play_ic" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="15dp" android:src="@drawable/ic_w_pause" android:contentDescription="@null"/>
        </FrameLayout>
        <FrameLayout android:id="@+id/w_next" android:layout_width="36dp" android:layout_height="36dp" >
            <ImageView android:id="@+id/w_next_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_btn_circle" android:contentDescription="@null"/>
            <ImageView android:id="@+id/w_next_ic" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="9dp" android:src="@drawable/ic_w_next" android:contentDescription="@null"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
